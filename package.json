{
  "name": "multilayer-mt",
  "version": "0.1.0",
  "description": "MultilayerMT: multi-layer (DOM, network, test-script) runtime mutation testing for Playwright E2E test suites",
  "keywords": [
    "mutation-testing",
    "playwright",
    "e2e",
    "web-testing",
    "test-adequacy",
    "dom",
    "network",
    "testing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ast-fortiss-tum/multilayer-mt.git"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./fixture": {
      "types": "./dist/src/runtime/fixture.d.ts",
      "default": "./dist/src/runtime/fixture.js"
    },
    "./browser": {
      "types": "./dist/src/browser/index.d.ts",
      "default": "./dist/src/browser/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mlmt": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "test:e2e": "tsc -p tsconfig.json && node --test dist/test/e2e/*.test.js",
    "demo": "npm run build && cd examples/todo-app && node ../../dist/src/cli.js run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^20.11.0"
  }
}
