{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MultilayerMT configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "app": { "type": "string", "description": "Name of the application under test (reports)." },
    "projectRoot": { "type": "string", "description": "Directory with node_modules/@playwright/test, relative to this file.", "default": "." },
    "playwrightConfig": { "type": "string", "default": "playwright.config.ts" },
    "testDir": { "type": "string", "default": "tests" },
    "testFilePattern": { "type": "string", "description": "Regex for test files (test-script layer).", "default": "\\.(spec|test)\\.(c|m)?(j|t)sx?$" },
    "maxPwe": { "type": "integer", "minimum": 1, "default": 100, "description": "Top-N Prioritized Web Elements per page." },
    "workers": { "type": "integer", "minimum": 1, "default": 4 },
    "baselineWorkers": { "type": "integer", "minimum": 1 },
    "layers": { "type": "array", "items": { "enum": ["dom", "network", "test"] }, "minItems": 1, "uniqueItems": true },
    "operators": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "operatorParams": { "type": "object", "additionalProperties": { "type": "object" } },
    "plugins": { "type": "array", "items": { "type": "string" }, "description": "Plugin modules with custom operators." },
    "reporters": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string", "description": "json | html | markdown | console | path to a reporter module" },
          { "type": "array", "items": [{ "type": "string" }, { "type": "object" }], "minItems": 2, "maxItems": 2 }
        ]
      }
    },
    "pageKeyQuery": { "anyOf": [{ "enum": ["all", "none"] }, { "type": "array", "items": { "type": "string" } }] },
    "network": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "resourceTypes": { "type": "array", "items": { "type": "string" } },
        "include": { "type": "string" },
        "exclude": { "type": "string" },
        "thirdParty": { "type": "boolean" }
      }
    },
    "test": {
      "type": "object", "additionalProperties": false,
      "properties": { "maxSitesPerOperator": { "type": "integer", "minimum": 1 } }
    },
    "testSelection": { "enum": ["covering", "all"] },
    "mutantTimeoutMs": { "type": "integer", "minimum": 1000 },
    "playwrightArgs": { "type": "array", "items": { "type": "string" } },
    "keepWebServer": { "type": "boolean" },
    "server": {
      "type": "object", "required": ["command", "url"], "additionalProperties": false,
      "properties": {
        "command": { "type": "string" }, "url": { "type": "string" }, "cwd": { "type": "string" }, "timeoutMs": { "type": "integer" }
      }
    },
    "outputDir": { "type": "string", "default": ".mlmt" },
    "sandboxDir": { "type": "string", "default": ".mutants" },
    "seed": { "type": "integer" },
    "maxElementsPerSnapshot": { "type": "integer", "minimum": 1 },
    "maxMutants": { "type": "integer", "minimum": 0 },
    "keepSandboxes": { "type": "boolean" },
    "requireGreenBaseline": { "type": "boolean" }
  }
}
